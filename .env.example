# ===================================================
# SOFA (Safe One For All) - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve gerekirse kendi
# değerlerinizi girin. .env dosyası ASLA git'e commit
# edilmemelidir (.gitignore içinde zaten hariç tutulur).
# ===================================================

# --- Chat & Assistant Module ---
# SOFA, sohbet için ücretsiz LLM sağlayıcılarını tek bir yerel
# ağ geçidi (gateway) üzerinden kullanır. Bu sayede tek tek
# API anahtarı aramak zorunda kalmazsınız.
#
# CHAT_PROVIDER seçenekleri:
#   "omniroute"  -> https://github.com/diegosouzapw/OmniRoute
#                   (zero-config, kurulum sonrası anahtar gerekmeden çalışır)
#   "freellmapi" -> https://github.com/tashfeenahmed/freellmapi
#                   (34+ ücretsiz LLM sağlayıcısını tek uçta birleştirir)
CHAT_PROVIDER=omniroute

# OmniRoute yerel sunucusu (varsayılan: npm install -g omniroute sonrası)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# FreeLLMAPI yerel sunucusu (varsayılan: install.sh sonrası)
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=

# Kullanılacak model adı ("auto" -> sağlayıcı en uygun ücretsiz modeli seçer)
CHAT_MODEL=auto

# --- Media Generation & Processing Module ---
# Görsel üretimi de aynı OpenAI-uyumlu ağ geçidi (/v1/images/generations)
# üzerinden yapılabilir. Ayrı bir anahtar gerekmez; CHAT_PROVIDER'daki
# sağlayıcı görsel üretimi de destekliyorsa otomatik kullanılır.
MEDIA_PROVIDER=omniroute

# --- System & Privacy Helper ---
# true ise hiçbir istek/yanıt içeriği diske veya konsola yazılmaz
SOFA_NO_LOG=true

# Uygulamanın çalışacağı host/port
SOFA_HOST=127.0.0.1
SOFA_PORT=8000
