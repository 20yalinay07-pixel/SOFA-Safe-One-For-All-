# ===================================================
# SOFA (Safe One For All) - Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve gerekirse kendi
# değerlerinizi girin. .env dosyası ASLA git'e commit
# edilmemelidir (.gitignore içinde zaten hariç tutulur).
# ===================================================

# --- Ağ Geçitleri (Gateways) ---
# SOFA, ücretsiz LLM'lere tek tek sağlayıcı anahtarı aramak yerine yerel
# OpenAI-uyumlu ağ geçitleri (gateway) üzerinden erişir:
#   - OmniRoute:  https://github.com/diegosouzapw/OmniRoute
#   - FreeLLMAPI: https://github.com/tashfeenahmed/freellmapi

# OmniRoute (npm install -g omniroute sonrası varsayılan; zero-config)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# FreeLLMAPI (install.sh sonrası varsayılan; panelden alınan birleşik anahtar)
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_API_KEY=

# --- Chat & Assistant Module ---
# Fallback zinciri: virgülle ayrılmış sağlayıcı sırası. İlk sağlayıcı
# başarısız olursa (ağ hatası / HTTP hatası / eksik anahtar) otomatik
# olarak bir sonrakine geçilir — kullanıcı hiçbir şey fark etmez.
# Varsayılan: FreeLLMAPI (ör. Groq - hızlı/güvenilir) önce, OmniRoute
# (ör. Gemini/Cerebras) yedek olarak sonra.
CHAT_PROVIDER_ORDER=freellmapi,omniroute

# Kullanılacak model adı ("auto" -> sağlayıcı en uygun ücretsiz modeli seçer)
CHAT_MODEL=auto

# --- Media Generation & Processing Module (Image Creation) ---
# Görsel üretimi için fallback zinciri. Varsayılan: OmniRoute önce (ör.
# Pollinations orada bağlıysa - hiçbir hesap gerekmez), FreeLLMAPI yedek
# olarak sonra.
MEDIA_PROVIDER_ORDER=omniroute,freellmapi

# ÖNEMLİ (OmniRoute kaynak koduyla doğrulandı): "model" ZORUNLU ve
# "provider/model" formatında olmalı - "auto"/boş çalışmaz.
#   pollinations/flux              (ÖNERİLEN - tamamen ücretsiz, OmniRoute
#                                   panelinde hesap/anahtar bağlamaya gerek
#                                   yok, anonim çalışır - kaynak kodda
#                                   doğrulandı)
#   pollinations/klein, pollinations/zimage, pollinations/qwen-image  (diğer ücretsiz seçenekler)
#   stability-ai/stable-image-core (Stability AI hesabınızda ücretli kredi gerekir)
# OmniRoute panelinizdeki "Resim" sekmesinden bağlı sağlayıcınızın tam
# kimliğini görüp buraya yazabilirsiniz.
IMAGE_MODEL=

# --- Music Creator Module ---
# 1. Öncelik: SunoAPI.org (gerçek müzik üretimi, SÖZLÜ - melodi/ritim/söz
#    hepsi var) - https://sunoapi.org. Ayrı bir hesap/anahtar gerektirir;
#    tanımlıysa otomatik kullanılır.
SUNOAPI_API_KEY=

# 2. Yedek: OmniRoute'un kendi native /v1/music/generations ucu - KIE.AI
#    (Suno) veya MiniMax OmniRoute panelinizde bağlıysa. ÖNEMLİ SINIRLAMA
#    (OmniRoute kaynak koduyla doğrulandı - bkz. open-sse/handlers/
#    musicGeneration.ts): OmniRoute'un KIE entegrasyonu "instrumental: true"yi
#    SABİT KODLUYOR - bu yoldan ASLA sözlü/kafiyeli şarkı çıkmaz, sadece
#    enstrümantal (melodi+ritim var, söz yok). Bu OmniRoute'un kendi
#    kısıtlaması, SOFA'nın kodundan bağımsız. Sözlü/kafiyeli şarkı
#    istiyorsanız yukarıdaki SunoAPI.org'u kullanın.
#      kie/suno-v4.0 veya kie/suno-v3.5   (KIE.AI hesabı gerekir, ücretli, enstrümantal)
#      minimax/music-3.0-free              (MiniMax hesabı gerekir, ücretsiz model var)
MUSIC_MODEL=

# 3. Son yedek (yukarıdakilerin ikisi de tanımlı değilse veya başarısız
#    olursa): aynı ağ geçitlerinin metinden-sese (TTS) ucu - gerçek müzik
#    üretmez, yalnızca bir ses taslağı döner.
#    ÖNEMLİ (OmniRoute kaynak koduyla doğrulandı): "model" burada da
#    ZORUNLU ve "provider/model" formatında olmalı - "auto" bile
#    çalışmaz. Ör. Deepgram bağlıysa: deepgram/aura-asteria-en,
#    deepgram/aura-luna-en, deepgram/aura-stella-en. Deepgram'da model
#    zaten sesi de belirlediği için MUSIC_TTS_VOICE gerekmez.
MUSIC_PROVIDER_ORDER=omniroute,freellmapi
MUSIC_TTS_MODEL=
MUSIC_TTS_VOICE=

# --- System & Privacy Helper ---
# true ise hiçbir istek/yanıt içeriği diske veya konsola yazılmaz
SOFA_NO_LOG=true

# Uygulamanın çalışacağı host/port
SOFA_HOST=127.0.0.1
SOFA_PORT=8000
